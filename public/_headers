# Cloudflare Pages headers.
# Next emits the generated OG card as an extensionless file (out/opengraph-image),
# so it would be served as application/octet-stream and every social crawler
# would reject it. Pin the type explicitly.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=31536000, immutable

/icon.svg
  Content-Type: image/svg+xml
  Cache-Control: public, max-age=604800

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
